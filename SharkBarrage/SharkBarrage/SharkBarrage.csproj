<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModType>mod</ModType>
    <ModName>SharkBarrage</ModName>
    <ModMain>SharkBarrage.SharkBarrageMain</ModMain>
    <AutoInstallMod Condition="'$(Configuration)' == 'Debug'">true</AutoInstallMod>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDiffCDB>false</GenerateDiffCDB>
    <GameVersion>35</GameVersion>
    <GenerateSinglePakFile>true</GenerateSinglePakFile>
  </PropertyGroup>

  <!-- ============ 数据补丁：攻速 x3 ============
       data.cdb（patch_shark_cdb.py 生成，csproj 同级）
         -> cdb diff（对比 MDK v35 模板）
         -> pak unpack
         -> Assets/data.cdb_/weapon/Shark.json
       再由 MDK 的 PackAssets 打成 res.pak 并自动安装到 coremod/mods/SharkBarrage/。
       运行时由 IOnAfterLoadingAssets 手动挂载，CDBManager 才会把它合进 data.cdb。

       ⚠ 数量 / 距离 / 穿墙 / 散射都是运行时改的（不打补丁），只有"攻速"走数据。 -->
  <PropertyGroup>
    <ModCdbFile>$(MSBuildProjectDirectory)/data.cdb</ModCdbFile>
    <TemplateCdbFile>$(_DCCM_Root)core/mdk/databases/v$(GameVersion)/data.cdb</TemplateCdbFile>
    <!-- 求值期 IntermediateOutputPath 还没定义，显式落到 obj/ 下，免得中间 pak 掉到项目根目录 -->
    <DiffPakPath>$(MSBuildProjectDirectory)/obj/_diffCDB.pak</DiffPakPath>
    <AssetDiffDir>$(MSBuildProjectDirectory)/Assets/data.cdb_</AssetDiffDir>
    <AssetDiffJson>$(AssetDiffDir)/weapon/Shark.json</AssetDiffJson>
    <!-- 补丁脚本放在工程目录的上一级（与 DamageAuraBoost / Sukuna 同一布局） -->
    <ModPatchScript>$(MSBuildProjectDirectory)/../patch_shark_cdb.py</ModPatchScript>
  </PropertyGroup>

  <!-- 脚本比 data.cdb 新（或 data.cdb 不存在）就重新生成 -->
  <Target Name="RegenCdb" BeforeTargets="BuildResPak"
          Inputs="$(ModPatchScript)"
          Outputs="$(ModCdbFile)">
    <Message Importance="high" Text="[SharkBarrage] 重新生成 data.cdb ..." />
    <Exec Command="python &quot;$(ModPatchScript)&quot;" />
  </Target>

  <Target Name="BuildResPak"
          BeforeTargets="PackAssetsIntoPak"
          DependsOnTargets="RegenCdb"
          Inputs="$(ModCdbFile);$(TemplateCdbFile)"
          Outputs="$(AssetDiffJson)"
          Condition="Exists('$(ModCdbFile)')">
    <Message Importance="high" Text="[SharkBarrage] 生成数据补丁 -> Assets/data.cdb_ ..." />
    <RemoveDir Directories="$(AssetDiffDir)" />
    <Exec Command="dotnet &quot;$(_DCCM_Root)core/mdk/tools/DCCMTool.dll&quot; cdb diff -i &quot;$(ModCdbFile)&quot; -t &quot;$(TemplateCdbFile)&quot; -o &quot;$(DiffPakPath)&quot;" />
    <Exec Command="dotnet &quot;$(_DCCM_Root)core/mdk/tools/DCCMTool.dll&quot; pak unpack -i &quot;$(DiffPakPath)&quot; -o &quot;$(MSBuildProjectDirectory)/Assets&quot;" />
    <!-- 重新收集 PackAssets（去掉评估期收集到的旧项，避免重复） -->
    <ItemGroup>
      <PackAssets Remove="@(PackAssets)" />
      <PackAssets Include="Assets/**/*" RootInPak="" />
    </ItemGroup>
  </Target>

  <!-- 没有 data.cdb 时（clone 下来直接构建）用仓库里已有的 Assets 打包 -->
  <ItemGroup>
    <PackAssets Include="Assets/**/*" RootInPak="" Condition="Exists('Assets')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
  </ItemGroup>

</Project>
