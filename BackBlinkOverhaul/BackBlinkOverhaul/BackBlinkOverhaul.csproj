<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModType>mod</ModType>
    <ModName>BackBlinkOverhaul</ModName>
    <ModMain>BackBlinkOverhaul.BackBlinkOverhaulMain</ModMain>
    <AutoInstallMod Condition="'$(Configuration)' == 'Debug'">true</AutoInstallMod>
    <AutoInstallMod Condition="'$(Configuration)' != 'Debug'">true</AutoInstallMod>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BackBlinkOverhaul</AssemblyName>
    <RootNamespace>BackBlinkOverhaul</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDiffCDB>false</GenerateDiffCDB>
    <GameVersion>35</GameVersion>
    <GenerateSinglePakFile>true</GenerateSinglePakFile>
  </PropertyGroup>

  <!-- ============ 数据补丁：Assets 打包 ============
       data.cdb（patch_blink_data.py 生成，csproj 同级）
         -> cdb diff（对比游戏模板）-> pak unpack
         -> Assets/data.cdb_/item/BackBlink.json
       然后由 MDK 的 PackAssets（GenerateSinglePakFile=true）
       把 Assets/**/* 打包成 res.pak 并自动安装到 coremod/mods/BackBlinkOverhaul/
       （模组自己的 sfx / atlas 等资源也一起进 res.pak） -->
  <PropertyGroup>
    <ModCdbFile>$(MSBuildProjectDirectory)/data.cdb</ModCdbFile>
    <TemplateCdbFile>$(_DCCM_Root)core/mdk/databases/v$(GameVersion)/data.cdb</TemplateCdbFile>
    <DiffPakPath>$(IntermediateOutputPath)_diffCDB.pak</DiffPakPath>
    <AssetDiffDir>$(MSBuildProjectDirectory)/Assets/data.cdb_</AssetDiffDir>
    <AssetDiffJson>$(AssetDiffDir)/item/BackBlink.json</AssetDiffJson>
  </PropertyGroup>

  <!-- patch 脚本比 data.cdb 新（或 data.cdb 缺失）就重新生成 -->
  <PropertyGroup>
    <PatchScript>$(MSBuildProjectDirectory)/patch_blink_data.py</PatchScript>
    <PatchScript Condition="!Exists('$(PatchScript)')">$(MSBuildProjectDirectory)/../patch_blink_data.py</PatchScript>
  </PropertyGroup>

  <Target Name="RegenCdb" BeforeTargets="BuildResPak"
          Inputs="$(PatchScript)"
          Outputs="$(ModCdbFile)">
    <Message Importance="high" Text="[BackBlinkOverhaul] patch_blink_data.py 有更新，重新生成 data.cdb ..." />
    <Exec Command="python &quot;$(PatchScript)&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

  <Target Name="BuildResPak"
          BeforeTargets="PackAssetsIntoPak"
          DependsOnTargets="RegenCdb"
          Condition="Exists('$(ModCdbFile)')">
    <Message Importance="high" Text="[BackBlinkOverhaul] 生成数据补丁 -> Assets/data.cdb_ ..." />
    <RemoveDir Directories="$(AssetDiffDir)" />
    <Exec Command="dotnet &quot;$(_DCCM_Root)core/mdk/tools/DCCMTool.dll&quot; cdb diff -i &quot;$(ModCdbFile)&quot; -t &quot;$(TemplateCdbFile)&quot; -o &quot;$(DiffPakPath)&quot;" />
    <Exec Command="dotnet &quot;$(_DCCM_Root)core/mdk/tools/DCCMTool.dll&quot; pak unpack -i &quot;$(DiffPakPath)&quot; -o &quot;$(MSBuildProjectDirectory)/Assets&quot;" />
    <ItemGroup>
      <PackAssets Remove="@(PackAssets)" />
      <PackAssets Include="Assets/**/*" RootInPak="" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackAssets Include="Assets/**/*" RootInPak="" Condition="Exists('Assets')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
  </ItemGroup>

</Project>
