<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModType>mod</ModType>
    <ModName>LightningWhipBoost</ModName>
    <ModMain>LightningWhipBoost.LightningWhipBoostMain</ModMain>
    <AutoInstallMod Condition="'$(Configuration)' == 'Debug'">true</AutoInstallMod>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDiffCDB>false</GenerateDiffCDB>
    <GameVersion>35</GameVersion>
    <GenerateSinglePakFile>true</GenerateSinglePakFile>
  </PropertyGroup>

  <!-- ============ 数据补丁：Assets 打包 ============
       data.cdb（patch_lightningwhip_cdb.py 生成，csproj 同级）
         -> cdb diff（对比游戏模板） -> pak unpack
         -> Assets/data.cdb_/item/LightningWhip.json
       然后由 MDK 的 PackAssets（GenerateSinglePakFile=true）
       把 Assets/**/* 打包成 res.pak 并自动安装到 coremod/mods/LightningWhipBoost/ -->
  <PropertyGroup>
    <ModCdbFile>$(MSBuildProjectDirectory)/data.cdb</ModCdbFile>
    <TemplateCdbFile>$(_DCCM_Root)core/mdk/databases/v$(GameVersion)/data.cdb</TemplateCdbFile>
    <DiffPakPath>$(IntermediateOutputPath)_diffCDB.pak</DiffPakPath>
    <AssetDiffDir>$(MSBuildProjectDirectory)/Assets/data.cdb_</AssetDiffDir>
    <AssetDiffJson>$(AssetDiffDir)/item/LightningWhip.json</AssetDiffJson>
  </PropertyGroup>

  <!-- 注意：这里【不能】加 Inputs/Outputs 做增量跳过。
       PackAssets 这一项是在本 Target 内部动态追加的，一旦本 Target 因"输出比输入新"
       被跳过，PackAssets 就为空 —— PackAssetsIntoPak 会打出一个空的 _pack_assets.pak，
       最终 res.pak 变成空包（数据补丁静默失效）。所以每次构建都重新生成，代价约 1 秒。 -->
  <Target Name="BuildResPak"
          BeforeTargets="PackAssetsIntoPak"
          Condition="Exists('$(ModCdbFile)')">
    <Message Importance="high" Text="[LightningWhipBoost] 生成数据补丁 -> Assets/data.cdb_ ..." />
    <RemoveDir Directories="$(AssetDiffDir)" />
    <Exec Command="dotnet &quot;$(_DCCM_Root)core/mdk/tools/DCCMTool.dll&quot; cdb diff -i &quot;$(ModCdbFile)&quot; -t &quot;$(TemplateCdbFile)&quot; -o &quot;$(DiffPakPath)&quot;" />
    <Exec Command="dotnet &quot;$(_DCCM_Root)core/mdk/tools/DCCMTool.dll&quot; pak unpack -i &quot;$(DiffPakPath)&quot; -o &quot;$(MSBuildProjectDirectory)/Assets&quot;" />
    <!-- 动态追加 PackAssets（Assets 在项目评估期还是空的，静态 ItemGroup 收集不到） -->
    <ItemGroup>
      <PackAssets Include="Assets/**/*" RootInPak="" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
  </ItemGroup>

</Project>
